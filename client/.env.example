# Leave the base URL blank in local development because Vite proxies /api.
# For a shared production forms API or Azure Function, set its HTTPS origin.
VITE_FORMS_API_BASE_URL=
VITE_CONTACT_FORM_ENDPOINT=/api/contact
VITE_INQUIRY_FORM_ENDPOINT=/api/contact

# Public Google reCAPTCHA v2 checkbox site key. Secret verification stays in the forms API.
VITE_RECAPTCHA_SITE_KEY=
