NODE_ENV=development
PORT=4100

# Comma-separated front-end origins. Localhost origins are included automatically in development.
ALLOWED_ORIGINS=https://diamondsuitescrystalriver.com,https://www.diamondsuitescrystalriver.com

# Set true when deploying the Docker image or serving the built React client from Express.
SERVE_CLIENT=true

# SMTP is optional in development. In production, configure these values so contact forms send email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO=ashley@diamondsuitesocala.com
CONTACT_FROM=website@diamondsuitescrystalriver.com
