NODE_ENV=development
PORT=4100

# Comma-separated front-end origins. Localhost origins are included automatically in development.
ALLOWED_ORIGINS=https://diamondsuitescrystalriver.com,https://www.diamondsuitescrystalriver.com

# Set true when deploying the Docker image or serving the built React client from Express.
SERVE_CLIENT=true

# Microsoft Graph application credentials. Keep every value in the server host only.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=
INQUIRY_RECIPIENT_EMAIL=ashley@diamondsuitesocala.com

# Google reCAPTCHA v2 secret. Never expose this value in the Vite client.
RECAPTCHA_SECRET_KEY=
